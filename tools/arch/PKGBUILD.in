# Generated by build-arch.sh from a locally compiled Arch Linux bundle.
pkgname=qingting
pkgver=@VERSION@
pkgrel=1
pkgdesc='Music search, playback, downloads and local library'
arch=('x86_64')
url='https://github.com/sadpotato1006/music_downloader'
depends=(
  'gtk3' 'mpv' 'glibc' 'gcc-libs' 'glib2' 'cairo' 'pango'
  'libepoxy' 'fontconfig' 'gdk-pixbuf2' 'harfbuzz' 'zlib'
  'mimalloc>=@MIMALLOC_ABI@' 'mimalloc<@MIMALLOC_NEXT_ABI@'
  'xdg-user-dirs' 'hicolor-icon-theme' 'libsecret'
  'webkit2gtk-4.1' 'libayatana-appindicator' 'libpulse'
)
optdepends=(
  'noto-fonts-cjk: Chinese, Japanese and Korean text rendering'
  'gnome-keyring: Secret Service for securely remembering cloud login (or another Secret Service provider)'
  'pipewire-pulse: PulseAudio compatibility for Bluetooth route monitoring with PipeWire'
  'gnome-shell-extension-appindicator: Tray support on GNOME; KDE has native support'
)
# Flutter already builds release binaries; keep its AOT and native assets intact.
options=('!strip' '!debug')
source=("qingting-${pkgver}-arch-x86_64-bundle.tar.gz")
sha256sums=('@SHA256@')

package() {
  install -d "$pkgdir/usr/lib/qingting" "$pkgdir/usr/bin"
  cp -a "$srcdir/qingting/." "$pkgdir/usr/lib/qingting/"
  ln -s /usr/lib/qingting/qingting "$pkgdir/usr/bin/qingting"
  install -Dm644 "$srcdir/com.pobb.qingting.desktop" \
    "$pkgdir/usr/share/applications/com.pobb.qingting.desktop"
  install -Dm644 "$srcdir/qingting.png" \
    "$pkgdir/usr/share/icons/hicolor/192x192/apps/com.pobb.qingting.png"
  install -Dm644 "$srcdir/README.txt" "$pkgdir/usr/share/doc/qingting/README.txt"
}
